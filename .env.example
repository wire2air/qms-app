VITE_PROXY_API_TARGET=http://localhost:5000/
VITE_PROXY_WORKER_TARGET=http://localhost:5002
VITE_PROXY_SYNC_TARGET=http://localhost:5003
VITE_ADMIN_EMAILS=yasin.quraishy@wire2air.com

# Subdomain tenancy: apex the tenant subdomains hang off. Tenant = first host
# label under this. Local: "localhost" (visit acme.localhost:5173). Prod: "qability.com".
VITE_ROOT_DOMAIN=localhost

# ── Marketing screenshots (scripts/marketing-shots, see its README) ──────────
# All optional; the values shown are the defaults. Shell variables override
# these, e.g. `THEME=dark node scripts/marketing-shots/run-all.mjs`.
# App to capture (Nordic demo tenant) and who logs in.
# NORDIC_URL=http://nordic.localhost:5173
# SHOTS_OWNER_EMAIL=astrid.lindqvist@qability.net
# SHOTS_OWNER_PASSWORD=12345678
# SHOTS_SUPPLIER_EMAIL=mette.kristensen@qability.net
# SHOTS_SUPPLIER_PASSWORD=12345678
# light | dark. dark writes to ../qms-marketing/marketing-assets-dark.
# THEME=light
# Tabs capturing side by side (webp defaults to 6). Above 4, pages start
# coming out half-loaded.
# WORKERS=4
# Output folder (default depends on THEME), and the site repo read for media.ts slots.
# ASSETS_DIR=../qms-marketing/marketing-assets
# MARKETING_DIR=../qms-marketing
# Read-only Postgres lookups for shots with a `sql` field.
# PG_CONTAINER=qms-postgres-1
# PG_DB=app-db
# edit.mjs input (default <ASSETS_DIR>/capture-log.json).
# CAPTURE_LOG=
