{
  "name": "app",
  "version": "0.0.1",
  "description": "A QMS Project",
  "productName": "QMS",
  "author": "Yasin Quraishy <yasin.quraishy@wire2air.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint \"./src*/**/*.{js,cjs,mjs,vue}\" \"./resource/**/*.{js,cjs,mjs,vue}\" && npm run lint:layout && npm run lint:ds && npm run lint:forms",
    "lint:layout": "node scripts/check-page-layout.mjs",
    "lint:ds": "node scripts/check-design-system.mjs",
    "lint:forms": "node scripts/check-form-system.mjs",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project=documents",
    "test:e2e:headed": "playwright test --project=documents --headed",
    "test:e2e:screens": "playwright test --project=screens",
    "test:e2e:screens:headed": "playwright test --project=screens --headed",
    "test:e2e:screens:docs": "playwright test --project=screens documents/screens",
    "test:e2e:screens:capas": "playwright test --project=screens capas/screens",
    "test:e2e:screens:ncr": "playwright test --project=screens nonconformances/screens",
    "test:e2e:screens:audits": "playwright test --project=screens audits/screens",
    "test:e2e:screens:training": "playwright test --project=screens training/screens",
    "test:e2e:screens:cr": "playwright test --project=screens changeRequests/screens",
    "test:e2e:screens:sites": "playwright test --project=screens sites/screens",
    "test:e2e:screens:depts": "playwright test --project=screens departments/screens",
    "test:e2e:screens:users": "playwright test --project=screens users/screens",
    "test:e2e:screens:roles": "playwright test --project=screens roles/screens",
    "test:e2e:screens:qe": "playwright test --project=screens qualityEvents/screens",
    "test:e2e:screens:qc": "playwright test --project=screens qcInspection/screens",
    "test:e2e:screens:workflow": "playwright test --project=screens workflow/screens",
    "test:e2e:screens:suppliers": "playwright test --project=screens suppliers/screens",
    "test:e2e:screens:auth": "playwright test --project=screens authentication/screens",
    "test:e2e:screens:multisite": "playwright test --project=screens multiSite/screens",
    "test:e2e:ncr": "playwright test --project=nonconformances",
    "test:e2e:ncr:headed": "playwright test --project=nonconformances --headed",
    "test:e2e:capas": "playwright test --project=capas",
    "test:e2e:sites": "playwright test --project=sites",
    "test:e2e:sites:headed": "playwright test --project=sites --headed",
    "test:e2e:depts": "playwright test --project=departments",
    "test:e2e:depts:headed": "playwright test --project=departments --headed",
    "test:e2e:audits": "playwright test --project=audits",
    "test:e2e:audits:headed": "playwright test --project=audits --headed",
    "test:e2e:auth": "playwright test --project=authentication",
    "test:e2e:auth:headed": "playwright test --project=authentication --headed",
    "test:e2e:users": "playwright test --project=users",
    "test:e2e:users:headed": "playwright test --project=users --headed",
    "test:e2e:roles": "playwright test --project=roles",
    "test:e2e:roles:headed": "playwright test --project=roles --headed",
    "test:e2e:qc": "playwright test --project=qcInspection",
    "test:e2e:qc:headed": "playwright test --project=qcInspection --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build:help": "node scripts/build-help-content.mjs",
    "publish:public-docs": "node scripts/publish-public-docs.mjs",
    "predev": "node scripts/build-help-content.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-help-content.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:video": "node video/run.js",
    "test:video:users": "node video/run.js --project=users",
    "test:video:headed": "VIDEO_HEADED=1 node video/run.js",
    "test:video:hd": "VIDEO_WIDTH=1920 VIDEO_HEIGHT=1080 node video/run.js",
    "test:video:steps": "VIDEO_STEP_MIN_MS=0 VIDEO_MAX_STEPS=200 node video/run.js",
    "test:video:full": "VIDEO_WIDTH=1920 VIDEO_HEIGHT=1080 VIDEO_STEP_MIN_MS=0 VIDEO_MAX_STEPS=200 node video/run.js",
    "test:video:all-browsers": "VIDEO_BROWSER=all node video/run.js",
    "video:record": "VIDEO_MODE=1 playwright test -c playwright.video.config.js",
    "video:build": "node video/build-videos.js",
    "video:report": "open artifacts/reports/index.html || xdg-open artifacts/reports/index.html",
    "video:instrument": "node video/instrument.js",
    "video:uninstrument": "node video/instrument.js --undo",
    "video:check": "node video/instrument.js --check",
    "video:clean": "rm -rf artifacts",
    "video:clean:module": "node -e \"const m=process.argv[1];if(!m){console.error('usage: npm run video:clean:module -- <module>');process.exit(1)}require('fs').rmSync('artifacts/'+m,{recursive:true,force:true});console.log('removed artifacts/'+m)\""
  },
  "dependencies": {
